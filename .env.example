# =============================================================================
# The ONLY variable you must set. Everything else is optional.
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
# =============================================================================
DATABASE_URL="postgresql://user:pass@host:5432/fastforward"

# --- Optional -----------------------------------------------------------------
# The app generates and stores its own push keys and session secret on first
# boot. Set these only if you want to control them yourself.

# Push notification identity — shows as the sender contact. Nice to set.
# VAPID_SUBJECT="mailto:you@example.com"

# Bring your own push keys instead of the generated pair (`npm run genkeys`).
# Setting these replaces whatever the app generated.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Bring your own session signing secret: openssl rand -base64 48
# SESSION_SECRET=""

# The reminder scheduler runs inside the server by default. Set to "false" and
# drive /api/cron/tick from Railway Cron instead (needed only if you ever run
# more than one instance).
# ENABLE_IN_PROCESS_CRON="true"
# CRON_SECRET="a-long-random-string"

# APP_URL="https://your-app.up.railway.app"

# --- Seeding (only used by `npm run db:seed`) --------------------------------
# SEED_EMAIL="you@example.com"
# SEED_PASSWORD="changeme123"
# SEED_NAME="Cody"
