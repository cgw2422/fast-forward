# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host:5432/fastforward"

# --- Auth -------------------------------------------------------------------
# 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Web Push (generate with: npm run genkeys) -------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Reminder engine --------------------------------------------------------
# Runs node-cron inside the Next server (single Railway service). Set to "false"
# and hit /api/cron/tick with the secret from Railway Cron instead.
ENABLE_IN_PROCESS_CRON="true"
CRON_SECRET="change-me"

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Seed (optional; only used by `npm run db:seed`) ------------------------
SEED_EMAIL="you@example.com"
SEED_PASSWORD="changeme123"
SEED_NAME="Cody"
